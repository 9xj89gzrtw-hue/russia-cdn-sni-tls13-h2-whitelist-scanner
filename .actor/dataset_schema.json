{
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "domain": {
        "type": "string",
        "description": "Scanned SNI domain (lowercase)."
      },
      "input": {
        "type": ["string", "null"],
        "description": "Domain exactly as the user typed it in the Actor input."
      },
      "category": {
        "type": ["string", "null"],
        "description": "Operator / CDN category label, e.g. Банки."
      },
      "ok": {
        "type": "boolean",
        "description": "True when the HTTPS status probe succeeded."
      },
      "tls13": {
        "type": "boolean",
        "description": "True when the bare TLS handshake negotiated TLS 1.3."
      },
      "alpn": {
        "type": ["string", "null"],
        "description": "Negotiated ALPN protocol, e.g. h2."
      },
      "ping_ms": {
        "type": ["integer", "null"],
        "description": "Measured TLS handshake time in milliseconds."
      },
      "https_status": {
        "type": ["integer", "null"],
        "description": "HTTPS response status code."
      },
      "recommended_client": {
        "type": ["string", "null"],
        "description": "Happ / v2rayNG / Sing-Box / Nekoray (Reality fp=chrome) recommendation."
      },
      "tier": {
        "type": ["string", "null"],
        "description": "demo | input | full."
      },
      "source": {
        "type": ["string", "null"],
        "description": "demo | input."
      },
      "compatibility": {
        "type": ["string", "null"],
        "description": "VLESS Reality / XHTTP ready (TLS1.3 + h2) | TLS reachable, ALPN not h2 | dead: no TLS/HTTPS handshake"
      },
      "fullBaseUrl": {
        "type": ["string", "null"],
        "description": "Storefront URL of the full verified base."
      },
      "offer": {
        "type": ["object", "null"],
        "description": "Pro offer summary record."
      }
    }
  },
  "views": {
    "scan": {
      "title": "SNI scan results",
      "transformation": {
        "fields": ["domain", "ok", "tls13", "alpn", "ping_ms", "https_status", "compatibility", "tier", "source"]
      },
      "display": { "component": "table" }
    },
    "demo": {
      "title": "Demo sample (25 domains)",
      "transformation": {
        "fields": ["domain", "category", "tls13", "alpn", "ping_ms", "https_status", "recommended_client"]
      },
      "display": { "component": "table" }
    },
    "offer": {
      "title": "Pro offer",
      "transformation": {
        "fields": ["offer"]
      },
      "display": { "component": "table" }
    }
  }
}
